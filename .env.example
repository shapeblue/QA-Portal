# GitHub API Token (optional, but recommended to avoid rate limits)
# Create a personal access token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Server Port
PORT=5001

# Log level for the structured (pino) logger: trace|debug|info|warn|error
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins for the public dashboard.
# Leave unset in local dev to reflect any origin. In production set to the
# portal's own origin, e.g. https://qa.example.com
# CORS_ORIGIN=https://qa.example.com

# Database Configuration
# These settings connect to the shared development/production database
DB_HOST=10.0.113.145
DB_PORT=3306
DB_NAME=cloudstack_tests
DB_USER=results
DB_PASSWORD=your_password_here

# Notes:
# - Get database credentials from your team lead
# - This connects to the shared database (read-only for dev)
# - Don't commit the .env file (it's in .gitignore)
